<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="FondoPantallas" Color="{DynamicResource ColorPantallas}"/>
    <Color x:Key="ColorPantallas">#001144</Color>
    <SolidColorBrush x:Key="FondoLetras" Color="{DynamicResource ColorLetras}"/>
    <Color x:Key="ColorLetras">#FFF</Color>
    <Style x:Key="TbiHeaderOculto" TargetType="{x:Type TabItem}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Label Name="Panel" Visibility="Collapsed" Foreground="Transparent" FontSize="1" FontWeight="Bold" Background="White" Padding="0">
                        <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="0"/>
                    </Label>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>