<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="TextoClaveID" TargetType="TextBox">
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Width" Value="332"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="{DynamicResource MarginTBMapeo}"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource CLRColorTablaContenidoForeground}"/>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="{DynamicResource FontZiseLetrasChicasMapeo}"/>
    </Style>
    
</ResourceDictionary>