<UserControl x:Class="AlohaWebServiceMobile.UcComponents.EditNewMapeoPago"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AlohaWebServiceMobile.UcComponents"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="{DynamicResource FondoPantallas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="65*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{DynamicResource TextoNuevoEditMapeo}" Style="{DynamicResource TBTitulos}"/>
        </Grid>

        <Grid Grid.Row="1" Margin="43,41,37,62" Background="White" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0">
                <Label Style="{DynamicResource LetrasMapeo}" Content="{DynamicResource TxtSeleccionPago}"/>
            </Grid>
            <ComboBox Grid.Column="1" Grid.Row="0" FontSize="16" x:Name="FormaDePago" DisplayMemberPath="NameDisplay" ItemsSource="{Binding ModeloNuevosMapeo}" SelectedItem="{Binding ModeloNuevoMapeo}" Margin="0,16,29,16"/>

            <Grid Grid.Row="2" Grid.Column="0">
                <Label Style="{DynamicResource LetrasMapeo}" Content="{DynamicResource TxtTipoPago}"/>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Nombre_pago_aloha}" Style="{DynamicResource TextoNuevoEditarMapeo}"/>

            <Grid Grid.Row="4" Grid.Column="0">
                <Label Style="{DynamicResource LetrasMapeo}" Content="{DynamicResource TxtClvID}"/>
            </Grid>
            <TextBox Grid.Row="4" Text="{Binding Clv_mapeo_pago }" Style="{DynamicResource TextoClaveID}" Margin="3,15,21,15"  Grid.Column="1"/>

        </Grid >

        <Grid Grid.Row="2" Background="White" Margin="43,0,37,27">

            <Button Grid.Row="2" Grid.Column="0" Content="{DynamicResource TxtBtnCancelar}" Style="{DynamicResource BotonesMapeo1}" Click="BtnCancelarMapeo"></Button>
            <Button Grid.Row="2" Grid.Column="1" Content="{DynamicResource TxtBtnGuardar}" Style="{DynamicResource BotonesMapeo2}" Click="BtnGuardar" ></Button>

        </Grid>

    </Grid>
</UserControl>
